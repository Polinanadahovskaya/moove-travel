e-columns: repeat(2, 1fr);\r\n    gap: 10px;\r\n  }\r\n  margin: 0 auto 50px;\r\n}\r\n\r\n@media (max-width: 1200px) {\r\n  .travel-body {\r\n    margin: 60px auto 120px;\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .travel-body {\r\n    margin: 20px auto 40px;\r\n    padding: 0;\r\n  }\r\n}\r\n\r\n@media (max-width: 576px) {\r\n  .travel-border {\r\n    width: 103px;\r\n    border-width: 2px;\r\n    margin: 7px 0 17px;\r\n  }\r\n\r\n  .travel-text {\r\n    font-size: 8px;\r\n    margin-bottom: 40px;\r\n  }\r\n}\r\n\r\n.none-art{\r\n  margin-top: 80px;\r\n  @media (max-width: 1200px) {\r\n    display: none;\r\n  }\r\n}\r\n.none-desk{\r\n  display: none;\r\n  @media (max-width: 1200px) {\r\n    display: block;\r\n  }\r\n}\r\n</style> "],"version":3}