{
  "kind": "collectionType",
  "collectionName": "guide_orders",
  "info": {
    "singularName": "guide-order",
    "pluralName": "guide-orders",
    "displayName": "Заявки на гиды"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "amount": {
      "type": "integer"
    },
    "travel_guide": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::travel-guide.travel-guide"
    },
    "payment_status": {
      "type": "enumeration",
      "enum": [
        "in_progress",
        "paid",
        "payment_failed",
        "canceled"
      ]
    },
    "emailSend": {
      "type": "boolean"
    }
  }
}
